# ---- Server ----
PORT=3000
# Beliebiger geheimer String, den du in Meta beim Webhook-Abo einträgst
VERIFY_TOKEN=bitte-aendern
# Geheimnis für /send und /mcp (Header: Authorization: Bearer <API_KEY> oder x-api-key)
API_KEY=bitte-aendern
# Optional: zusätzlicher Pfad-Schlüssel, damit claude.ai den MCP ohne Header erreichen kann:
# MCP wird dann unter /mcp/<MCP_PATH_SECRET> angeboten
MCP_PATH_SECRET=

# ---- Meta / WhatsApp Cloud API ----
META_APP_SECRET=            # Meta App -> Einstellungen -> Allgemein -> App-Geheimcode (für Signaturprüfung)
WHATSAPP_TOKEN=             # Permanenter System-User-Token mit whatsapp_business_messaging + whatsapp_business_management
WHATSAPP_PHONE_NUMBER_ID=   # WhatsApp -> API-Setup -> "Phone number ID"
GRAPH_API_VERSION=v25.0
MARK_AS_READ=true           # eingehende Nachrichten in WhatsApp als gelesen markieren (blaue Haken)

# ---- HubSpot ----
HUBSPOT_TOKEN=              # Private App Token (Scopes siehe README)
HUBSPOT_OWNER_ID=           # optional: Owner-ID, die als Absender/Logger der Nachrichten erscheint
HUBSPOT_PORTAL_ID=26200447  # für Links auf Kontakte (Bodenfix-Portal, EU)
HUBSPOT_PHONE_INDEX_PROPERTY=whatsapp_e164
HUBSPOT_SYNC_INTERVAL_MINUTES=15
UPLOAD_MEDIA_TO_HUBSPOT=true   # Sprachnachrichten/Bilder/Dokumente als Datei an die Nachricht hängen

# ---- Lead-Regel für unbekannte Nummern ----
# inbound  = jede unbekannte Nummer, die schreibt, wird als Lead angelegt (Standard)
# classify = Claude prüft zuerst, ob es eine Kundenanfrage ist (braucht ANTHROPIC_API_KEY)
# never    = keine Kontakte anlegen, nur bekannte Nummern synchronisieren
LEAD_POLICY=inbound
LEAD_STATUS=NEW                 # hs_lead_status-Wert (NEW = "Neuer Kontakt")
LIFECYCLE_STAGE=lead
LEADHERKUNFT_VALUE=             # optional, z. B. "WhatsApp" (Option muss in HubSpot existieren)
DEFAULT_COUNTRY_CODE=49

# ---- Transkription von Sprachnachrichten (optional) ----
OPENAI_API_KEY=
TRANSCRIBE_MODEL=gpt-4o-transcribe
TRANSCRIBE_LANGUAGE=de

# ---- Claude (nur für LEAD_POLICY=classify) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- Ablage ----
STATE_FILE=./data/state.json
